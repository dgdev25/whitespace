# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./whitespace.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/whitespace

RUVECTOR_BASE_URL=http://localhost:18732
EMBEDDINGS_MODE=full

# LLM runner — first available key wins
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AI...
OPENROUTER_API_KEY=sk-or-...
# A model is REQUIRED when calling OpenRouter directly — there is deliberately
# no implicit default, because an unset value used to resolve to the newest
# Claude Opus and bill for every request.
OPENROUTER_ANALYSIS_MODEL=google/gemma-4-31b-it:free
# Optional: send completions somewhere OpenAI-compatible instead of OpenRouter.
# myportfolio sets this to its relay, which holds the key and falls through a
# chain of free models — with it set, OPENROUTER_API_KEY is not needed here.
# OPENROUTER_BASE_URL=http://gateway-orchestrator:8081/llm/v1
# Leave unset to auto-resolve the newest Claude Opus OpenRouter offers (no version pin)

# GitHub token (optional — increases rate limit from 60 to 5000 req/hr)
# GITHUB_TOKEN=ghp_...

# CORS allowed origins (comma-separated, defaults to localhost dev)
CORS_ORIGINS=http://localhost:18731

PIPELINE_MODE=full
WORKER_SCHEDULE_HOUR=2
WORKER_SCHEDULE_MINUTE=0
ARXIV_ORGS=DeepMind,Anthropic,OpenAI
ARXIV_CATEGORIES=cs.LG,cs.AI,cs.SE,cs.HC,cs.AR,cs.DC,eess.SP
IDEAS_PER_RUN=8
